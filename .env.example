# Токен Discord бота (получить в https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here

# API ключ Google Gemini (бесплатно в https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Модель Gemini (рекомендуется gemini-1.5-flash или gemini-2.0-flash-exp)
GEMINI_MODEL=gemini-1.5-flash

# Название вашего проекта / сервера
SERVER_NAME=Наш Игровой Сервер

# ID канала для вопросов (бот будет автоматически создавать отдельную ветку под каждое сообщение!)
# Чтобы получить ID: Включите Режим разработчика в Discord -> Правый клик по каналу -> Скопировать ID
HELP_CHANNEL_ID=

# Роль администратора для команд управления (/reload_rules) (необязательно)
ADMIN_ROLE_NAME=Администратор

# Ограничения запросов к ИИ от одного игрока (защита от спама)
# Максимум запросов от игрока за день (по умолчанию 5)
RATE_LIMIT_MAX_REQUESTS=5
# Размер окна в секундах (86400 сек = 24 часа = 1 день)
RATE_LIMIT_WINDOW_SECONDS=86400
# Минимальная пауза (кд) между вопросами в секундах (60 сек)
RATE_LIMIT_COOLDOWN_SECONDS=60
